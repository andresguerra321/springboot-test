<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="backIntroPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades mapeadas para validación y persistencia -->
        <class>com.backintro.infrastructure.adapters.outbound.persistence.entities.CountryJpaEntity</class>

        <properties>
            <!-- Conexión JDBC PostgreSQL estándar (Jakarta Persistence) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/backintro_db"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>

            <!-- Dialecto Hibernate para PostgreSQL -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Validación estricta contra el schema.sql ya existente (no altera el esquema) -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Logs detallados y legibles de consultas SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>

            <!-- Pool de conexiones JDBC básico de Hibernate -->
            <property name="hibernate.connection.pool_size" value="10"/>

            <!-- Desactivar escaneo innecesario en Java SE -->
            <property name="hibernate.archive.autodetection" value="class"/>
        </properties>
    </persistence-unit>

</persistence>
